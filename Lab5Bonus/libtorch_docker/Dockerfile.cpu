
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    wget \
    unzip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN wget -q https://download.pytorch.org/libtorch/cpu/libtorch-cxx11-abi-shared-with-deps-2.6.0%2Bcpu.zip -O libtorch.zip && \
    unzip -q libtorch.zip -d /opt && \
    rm libtorch.zip

ENV CMAKE_PREFIX_PATH=/opt/libtorch

COPY CMakeLists.txt /app/
COPY main.cpp /app/

RUN cmake -B build -DCMAKE_PREFIX_PATH=${CMAKE_PREFIX_PATH} -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build --config Release -j$(nproc)

VOLUME ["/app/checkpoints"]

ENTRYPOINT ["./build/libtorch_benchmark"]
CMD ["checkpoints/best_resnet34_traced.pt", "cpu", "50", "200"]
